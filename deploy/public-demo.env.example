# Copy to .env.production for a separate SYNTHETIC DEMO deployment.
# No Supabase/Auth0 account or business registration is needed for this demo configuration.
NODE_ENV=production
PUBLIC_DEMO=true
PUBLIC_ORIGIN=https://your-subdomain.duckdns.org
SESSION_KEY=
PORT=3001
# Compose overrides this with the exact Caddy IP.
TRUST_PROXY=
