# Copy to .env.backup in the repository root, chmod 600. Never commit credentials.
# PostgreSQL 17: owner/backup role must bypass RLS to export ALL tenants.
BACKUP_DATABASE_URL=
# OCI Object Storage S3-compatible endpoint: use a different region/account from compute where possible.
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=/run/secrets/restic-password
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
# Set only during an isolated restore drill. Database must already exist and be empty.
RESTORE_DATABASE_URL=
CONFIRM_RESTORE_DATABASE=
RESTORE_SNAPSHOT=latest
