{
  "name": "materialovy-hlidac",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch apps/api/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts && node scripts/build-server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx apps/api/server.ts",
    "test:e2e": "playwright test",
    "validate:data": "tsx scripts/validate-data.ts",
    "format": "prettier --write apps packages fixtures tests scripts *.json *.ts docs README.md SECURITY.md .github",
    "format:check": "prettier --check apps packages fixtures tests scripts *.json *.ts docs README.md SECURITY.md .github",
    "security:scan": "node scripts/check-secrets.mjs",
    "benchmark": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/secure-session": "^8.4.0",
    "@fastify/static": "^10.1.5",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.0.0",
    "lucide-react": "^0.468.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.28.2",
    "fast-check": "^4.0.0",
    "jose": "^6.2.12",
    "prettier": "^3.9.9",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  }
}
